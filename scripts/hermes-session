#!/usr/bin/env bash
# omarchy:summary=Open a Hermes session in a terminal TUI — local or remote over SSH (companion to the hermes-sessions bar plugin)
# omarchy:args=<session-id> [profile] [useTui]
# Run INSIDE a terminal (omarchy-launch-or-focus-tui provides one); never spawns
# a terminal emulator itself. Empty session-id starts a fresh Hermes TUI; the
# optional 2nd arg (or HERMES_PROFILE env) selects a Hermes profile.
# 3rd arg or HERMES_USE_TUI env controls TUI (--tui when true, omit when false; default true).
#
# Error visibility: failures print the reason and wait for ENTER instead of
# letting the host terminal close on an invisible error.
set -u

_REMOTE_SET=0; [[ -n "${HERMES_REMOTE_HOST+set}" ]] && _REMOTE_SET=1 && _REMOTE_VAL="$HERMES_REMOTE_HOST"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ $_REMOTE_SET -eq 0 ]]; then
  # shellcheck disable=SC1091
  [[ -f "$SCRIPT_DIR/../remote.conf" ]] && source "$SCRIPT_DIR/../remote.conf"
fi
REMOTE_HOST="${HERMES_REMOTE_HOST-}"

SESSION_ID="${1:-}"
PROFILE="${2:-${HERMES_PROFILE:-}}"
# Sentinel for new-session (Panel.qml passes "__new__" to avoid empty-arg stripping
# through omarchy-launch-or-focus-tui -> omarchy-launch-tui -> eval).
if [[ "$SESSION_ID" == "__new__" ]]; then SESSION_ID=""; fi
# Legacy stripped case: Panel passed "" kana but the launcher chain stripped "" so
# the call arrived as `hermes-tui-session kana` (profile shifted into $1). Detect
# single-arg profile-for-new-session and shift it back.
if [[ -n "$SESSION_ID" && -z "${2:-}" && -z "$PROFILE" ]]; then
  _san=$(printf %s "$SESSION_ID" | tr -d '\r\n' | head -c 64)
  if [[ "$_san" =~ ^[a-zA-Z0-9._-]+$ ]] && [[ ! "$SESSION_ID" =~ ^[0-9]{8}_ ]] && [[ ! "$SESSION_ID" =~ ^cron_ ]]; then
    PROFILE="$_san"
    SESSION_ID=""
    PROFILE=$(printf %s "$PROFILE" | tr -d '\r\n' | head -c 64)
    [[ "$PROFILE" =~ ^[a-zA-Z0-9._-]+$ ]] || PROFILE=""
  fi
fi
# Sanitize profile: hostname-safe chars only (it is interpolated into a remote command)
PROFILE=$(printf %s "$PROFILE" | tr -d '\r\n' | head -c 64)
[[ "$PROFILE" =~ ^[a-zA-Z0-9._-]+$ ]] || PROFILE=""

# --- TUI flag (global boolean, default true) ---
# Panel.qml passes HERMES_USE_TUI env and 3rd arg; script supports both.
USE_TUI_RAW="${3:-${HERMES_USE_TUI:-}}"
if [[ -z "$USE_TUI_RAW" ]]; then
  USE_TUI=1
else
  case "$USE_TUI_RAW" in
    1|true|TRUE|True|yes|YES|on|ON) USE_TUI=1 ;;
    0|false|FALSE|False|no|NO|off|OFF) USE_TUI=0 ;;
    *) USE_TUI=1 ;;
  esac
fi
if [[ "$USE_TUI" == "1" ]]; then
  TUI_FLAG=" --tui"
else
  TUI_FLAG=""
fi

fail() { # $1 = exit code, rest = message lines
  local rc="$1"; shift
  echo ""
  echo "[hermes-sessions] Failed (exit $rc)"
  for line in "$@"; do echo "  $line"; done
  echo "[hermes-sessions] Press ENTER to close..."
  read -r
  exit "$rc"
}

run_remote() {
  local remote_cmd="$1" rc
  # -tt forces PTY allocation through xdg-terminal-exec/systemd-run wrappers.
  ssh -tt -o ConnectTimeout=5 -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
      -o ServerAliveInterval=30 "$REMOTE_HOST" "$remote_cmd"
  rc=$?
  [[ $rc -eq 0 ]] || fail "$rc" "host: $REMOTE_HOST" "cmd : $remote_cmd"
  exit 0
}

if [[ -n "$REMOTE_HOST" ]] && ssh -o ConnectTimeout=2 -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$REMOTE_HOST" "exit" 2>/dev/null; then
  # Canonical hermes: `hermes -p <profile> chat --tui` and `... chat --resume <id> --tui`.
  # -p is global and comes before the subcommand `chat`. Omit for default/empty.
  # TUI_FLAG controls --tui presence (omit when useTui=false, no --cli).
  p_flag=""
  [[ -n "$PROFILE" && "$PROFILE" != "default" ]] && p_flag="-p $PROFILE"
  if [[ -z "$SESSION_ID" ]]; then
    # shellcheck disable=SC2086 — p_flag is controlled word list (or empty)
    run_remote "docker exec -it hermes hermes $p_flag chat$TUI_FLAG"
  fi
  run_remote "docker exec -it hermes hermes $p_flag chat --resume \"$SESSION_ID\"$TUI_FLAG"
fi

# --- Local fallback ---
run_local() {
  local rc
  "$@"
  rc=$?
  [[ $rc -eq 0 ]] || fail "$rc" "cmd : $*"
  exit 0
}
if [[ -z "$SESSION_ID" ]]; then
  if [[ -n "$PROFILE" && "$PROFILE" != "default" ]]; then
    if [[ "$USE_TUI" == "1" ]]; then
      run_local hermes -p "$PROFILE" chat --tui
    else
      run_local hermes -p "$PROFILE" chat
    fi
  else
    if [[ "$USE_TUI" == "1" ]]; then
      run_local hermes chat --tui
    else
      run_local hermes chat
    fi
  fi
fi
if [[ -n "$PROFILE" && "$PROFILE" != "default" ]]; then
  if [[ "$USE_TUI" == "1" ]]; then
    run_local hermes -p "$PROFILE" chat --resume "$SESSION_ID" --tui
  else
    run_local hermes -p "$PROFILE" chat --resume "$SESSION_ID"
  fi
else
  if [[ "$USE_TUI" == "1" ]]; then
    run_local hermes chat --resume "$SESSION_ID" --tui
  else
    run_local hermes chat --resume "$SESSION_ID"
  fi
fi
